#!/usr/bin/env ruby
require "fileutils"
Dir.chdir(File.expand_path("..", __dir__)) do
  abort "Setup is development-only" if ENV.fetch("RAILS_ENV", "development") != "development"
  system("bundle check") || system("bundle install", exception: true)
  system("bin/rails", "db:prepare", "db:seed", exception: true)
  puts "Operator: operator@example.test. Read tmp/demo_password locally; do not publish it."
  puts "Start Redis, then run bin/worker and bin/dev in separate terminals."
end
